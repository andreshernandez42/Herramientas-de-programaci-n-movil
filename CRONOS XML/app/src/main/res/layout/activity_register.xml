<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/cronos_light">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp"
        android:gravity="center">
        <LinearLayout android:id="@+id/cardRegisterHeader"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingTop="22dp" android:paddingBottom="22dp"
            android:elevation="6dp"
            android:background="@drawable/bg_cronos_header">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏱" android:textSize="38sp"/>
            <TextView android:id="@+id/tvRegisterTitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/register_title" android:textColor="@color/white"
                android:textStyle="bold" android:textSize="20sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Comienza a optimizar tu rutina" android:textColor="@color/white"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Crear Cuenta" android:textColor="@color/cronos_navy"
            android:textStyle="bold" android:textSize="20sp" android:layout_marginTop="22dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ingresa tus datos personales" android:textColor="@color/cronos_gray"
            android:textSize="12sp" android:layout_marginTop="4dp"/>

        <EditText android:id="@+id/etFullName"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Nombre completo" android:inputType="textPersonName"
            android:layout_marginTop="22dp"/>
        <EditText android:id="@+id/etRegisterEmail"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Correo electrónico" android:inputType="textEmailAddress"
            android:layout_marginTop="10dp"/>
        <EditText android:id="@+id/etRegisterPassword"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Contraseña" android:inputType="textPassword"
            android:layout_marginTop="10dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRegister"
            style="@style/CronosBotonPrincipal"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Registrarse" android:layout_marginTop="14dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBackLogin"
            style="@style/CronosBotonGris"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="← Volver a Iniciar Sesión"
            android:layout_marginTop="12dp"/>
    </LinearLayout>
</ScrollView>
