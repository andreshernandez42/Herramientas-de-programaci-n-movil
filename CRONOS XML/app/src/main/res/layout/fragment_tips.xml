<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cronos_light">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💡 Tips Pro para el Éxito" android:textStyle="bold"
            android:textSize="24sp" android:textColor="@color/cronos_navy"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTip1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="1. Organización por Categorías\n\nMantén agrupadas tus responsabilidades en Casa, Universidad y Trabajo."
                android:padding="18dp" android:textColor="@color/cronos_navy"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTip2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="2. Priorización Inteligente\n\nEmpieza siempre el día revisando las tareas marcadas con prioridad Alta."
                android:padding="18dp" android:textColor="@color/cronos_navy"/>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTip3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="3. Descansos Activos\n\nUtiliza la técnica Pomodoro: trabaja 25 minutos y descansa 5."
                android:padding="18dp" android:textColor="@color/cronos_navy"/>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
