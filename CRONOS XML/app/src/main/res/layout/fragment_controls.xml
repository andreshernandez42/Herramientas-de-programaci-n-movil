<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cronos_light">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⚙ Panel de Botones y Controles"
            android:textColor="@color/cronos_navy"
            android:textStyle="bold" android:textSize="22sp"/>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_panel" android:layout_marginTop="16dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Crear Tarea Rápida" android:textStyle="bold"
                android:textColor="@color/cronos_cyan_dark"/>
            <EditText
                android:id="@+id/etQuickTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Título" android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/etQuickDescription"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Descripción" android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/spQuickCategory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <Spinner
                android:id="@+id/spQuickPriority"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <Button
                android:id="@+id/btnSaveQuickTask"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Guardar Tarea" android:textColor="@color/white"
                android:backgroundTint="@color/cronos_cyan" android:layout_marginTop="12dp"/>
        </LinearLayout>
        <Button
            android:id="@+id/btnReminder"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="⏰ Programar Recordatorio"
            android:textColor="@color/white" android:backgroundTint="@color/cronos_green"
            android:layout_marginTop="14dp"/>
        <Button
            android:id="@+id/btnTags"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🏷 Organizar por Etiquetas"
            android:textColor="@color/white" android:backgroundTint="@color/cronos_blue"
            android:layout_marginTop="10dp"/>
        <Button
            android:id="@+id/btnClearCompleted"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="🧹 Limpiar Completadas"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:textColor="@color/cronos_navy"
            app:strokeColor="@color/cronos_navy" app:strokeWidth="1dp"
            android:layout_marginTop="10dp"/>

        <!-- mas controles -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp"
            android:background="@drawable/bg_panel" android:layout_marginTop="16dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⏱ Sesión de concentración" android:textStyle="bold"
                android:textColor="@color/cronos_cyan_dark"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swFocusMode"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Modo concentración"
                android:textColor="@color/cronos_navy"/>
            <TextView
                android:id="@+id/tvFocusMinutes"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Duración: 25 minutos"
                android:textColor="@color/cronos_navy"/>
            <SeekBar
                android:id="@+id/sbFocusMinutes"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="60" android:progress="25"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tipo de descanso" android:textColor="@color/cronos_navy"/>
            <RadioGroup
                android:id="@+id/rgBreakType"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rbBreakShort"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Corto (5 min)" android:checked="true"/>
                <RadioButton
                    android:id="@+id/rbBreakLong"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Largo (15 min)"/>
            </RadioGroup>
            <CheckBox
                android:id="@+id/cbFocusSound"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Avisar al terminar"/>
            <Button
                android:id="@+id/btnStartFocus"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Iniciar sesión" android:enabled="false"
                android:textColor="@color/white" android:backgroundTint="@color/cronos_navy"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
