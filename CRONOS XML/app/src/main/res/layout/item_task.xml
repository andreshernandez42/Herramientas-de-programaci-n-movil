<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp" app:cardElevation="3dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical">
        <CheckBox android:id="@+id/cbTaskDone"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView android:id="@+id/tvTaskTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textStyle="bold" android:textColor="@color/cronos_navy"
                android:textSize="17sp"/>
            <TextView android:id="@+id/tvTaskDescription"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/cronos_gray" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/tvTaskMeta"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/cronos_cyan_dark" android:textSize="12sp"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btnDeleteTask"
            android:layout_width="44dp" android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@android:color/transparent"
            android:contentDescription="Eliminar tarea"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
