<?xml version="1.0" encoding="utf-8"?>
<!-- formulario nueva tarea -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layout_marginTop="10dp">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_card">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Nueva tarea" android:textStyle="bold"
            android:textSize="16sp" android:textColor="@color/cronos_navy"/>

        <EditText android:id="@+id/etNewTitle"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Título de la tarea *"
            android:inputType="textCapSentences"/>
        <EditText android:id="@+id/etNewDescription"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Descripción (opcional)"
            android:inputType="textCapSentences"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Categoría" android:textSize="12sp" android:textColor="@color/cronos_gray"/>
        <Spinner android:id="@+id/spNewCategory"
            android:layout_width="match_parent" android:layout_height="44dp"/>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Prioridad" android:textSize="12sp" android:textColor="@color/cronos_gray"/>
        <Spinner android:id="@+id/spNewPriority"
            android:layout_width="match_parent" android:layout_height="44dp"/>

        <TextView android:id="@+id/tvNewDate"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:hint="📅 Fecha límite (toque para elegir)"/>
        <TextView android:id="@+id/tvNewReminder"
            style="@style/CronosInput"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:hint="⏰ Recordatorio (opcional)"/>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCancelNewTask"
                style="@style/CronosBotonGris"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancelar"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveNewTask"
                style="@style/CronosBotonPrincipal"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Guardar"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
