<?xml version="1.0" encoding="utf-8"?>
<!-- widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/bg_cronos_header">
    <TextView
        android:id="@+id/tvWidgetTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⏰ CRONOS"
        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp"/>
    <TextView
        android:id="@+id/tvWidgetPending"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Organiza tu tiempo"
        android:textColor="#FFFFFF" android:textSize="13sp"/>
    <Button
        android:id="@+id/btnWidgetOpen"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Abrir"
        android:textColor="#10305C"/>
</LinearLayout>
