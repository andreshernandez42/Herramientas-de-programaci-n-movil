<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@color/cronos_cyan">
    <TextView android:id="@+id/tvSplashLogo"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="⌛" android:textSize="72sp" android:contentDescription="Logo CRONOS"/>
    <TextView android:id="@+id/tvSplashTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Cronos Tareas" android:textColor="@color/cronos_navy"
        android:textStyle="bold" android:textSize="28sp" android:layout_marginTop="8dp"/>
    <ProgressBar android:id="@+id/pbSplashLoading"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <TextView android:id="@+id/tvSplashLoading"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/loading" android:textColor="@color/white"
        android:layout_marginTop="12dp"/>
</LinearLayout>
