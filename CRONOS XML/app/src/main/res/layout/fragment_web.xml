<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@color/cronos_light">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="🌐 Web" android:textStyle="bold" android:textSize="24sp"
        android:textColor="@color/cronos_navy"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="12dp">
        <EditText
            android:id="@+id/etWebUrl"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="https://example.com"
            android:inputType="textUri" android:singleLine="true"/>
        <Button
            android:id="@+id/btnWebGo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ir" android:backgroundTint="@color/cronos_cyan"
            android:textColor="@color/white"/>
    </LinearLayout>
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="10dp"/>
</LinearLayout>
