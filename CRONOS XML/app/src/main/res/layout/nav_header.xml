<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp"
    android:background="@color/cronos_cyan">
    <ImageView android:id="@+id/ivNavLogo"
        android:layout_width="56dp" android:layout_height="56dp"
        android:src="@drawable/ic_cronos_clock"
        android:contentDescription="Logo CRONOS"/>
    <TextView android:id="@+id/tvNavUserName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="Cronos Tareas"
        android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp"/>
    <TextView android:id="@+id/tvNavUserEmail"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/login_subtitle"
        android:textColor="@color/white" android:textSize="13sp"/>
</LinearLayout>
