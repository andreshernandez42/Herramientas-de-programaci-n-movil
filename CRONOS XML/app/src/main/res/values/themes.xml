<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cronos" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/cronos_cyan</item>
        <item name="colorPrimaryVariant">@color/cronos_cyan_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/cronos_navy</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/cronos_cyan_dark</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- estilos propios -->
    <style name="CronosInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cronos_navy</item>
        <item name="android:textColorHint">#9AA5B1</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CronosBotonPrincipal" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/cronos_cyan</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="CronosBotonDelineado" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="strokeColor">@color/cronos_cyan</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/cronos_cyan_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="CronosBotonGris" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="strokeColor">#D9E2E7</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">#F7FBFC</item>
        <item name="android:textColor">@color/cronos_gray</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">12dp</item>
    </style>
    <style name="CronosPildora" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/cronos_navy</item>
        <item name="strokeColor">#D9E2E7</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>
